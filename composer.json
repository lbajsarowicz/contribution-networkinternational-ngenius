{
  "name": "networkinternational/ngenius",
  "description": "N-Genius Online by Network Payment Gateway for Magento 2",
  "type": "magento2-module",
  "version": "1.4.2",
  "minimum-stability": "stable",
  "license": "GPL-3.0",
  "authors": [
    {
      "name": "App Inlet (Pty) Ltd",
      "email": "info@appinlet.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ngenius/ngenius-common": "v1.3.0"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "NetworkInternational\\NGenius\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
